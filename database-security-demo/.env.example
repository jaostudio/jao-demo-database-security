# Auth (required)
NEXTAUTH_SECRET="change-to-a-32-byte-random-secret-at-least-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# Demo mode — enables sandboxed SQLite writes protecting Turso production data
SANDBOX_MODE="false"

# Registration — disabled in production; enable for local testing
DEMO_REGISTRATION_ENABLED="false"

# Turso (production / demo — optional, falls back to local dev.db)
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="replace-with-your-turso-token"

# Local Prisma migration database (SQLite)
DATABASE_URL="file:./dev.db"
